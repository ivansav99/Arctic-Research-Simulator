diff --git a/style.css b/style.css
index 5770668..5121cba 100644
--- a/style.css
+++ b/style.css
@@ -177,4 +177,44 @@ body { overscroll-behavior: none; touch-action: none; }
   #arx-root .arx-dashboard-ship { grid-row:auto; }
   #arx-root .arx-resupply.compact { grid-template-columns:1fr 1fr; }
   #arx-root .arx-dashboard-ship > img { height:135px; }
