# One cash-register ding everywhere; heavy metal port bell; ferry horn on departure.
pattern = re.compile(r"case'cash-in':.*?break;case'cash-out':.*?break;case'data':", re.S)
repl = "case'cash':case'cash-in':case'cash-out':burst(.035,.045,1500,5200);tone(1480,.075,.055,.015,'square');tone(2080,.16,.045,.045,'sine');break;case'data':"
g,n = pattern.subn(repl,g,count=1)
if n != 1: raise SystemExit(f'cash sound cases: {n}')
pattern = re.compile(r"case'port':.*?break;case'ice':", re.S)
repl = "case'port':burst(.09,.11,420,3200);tone(285,2.4,.12,0,'sine');tone(438,2.05,.075,.01,'sine');tone(672,1.65,.052,.015,'sine');tone(910,1.1,.032,.02,'sine');break;case'depart':tone(104,1.85,.12,0,'sawtooth');tone(156,1.7,.075,.015,'sine');tone(208,1.45,.045,.025,'sine');break;case'ice':"
g,n = pattern.subn(repl,g,count=1)
if n != 1: raise SystemExit(f'port sound case: {n}')

# iPad/iPhone render at a saner backing resolution; CSS geometry is unchanged.
g = replace_once(g,
    "function resize(){dpr=Math.min(devicePixelRatio||1,2);",
    "function resize(){dpr=Math.min(devicePixelRatio||1,IS_COARSE_POINTER?1.35:2);",
    'mobile dpr')

# Make the normal wake visible and long-lived, while keeping it fixed in map coordinates.
g = replace_once(g,
    "wakeTrail.push({x:state.x-headingX*back+sideX*side,y:state.y-headingY*back+sideY*side,life:5.8,maxLife:5.8,size:2.1+Math.random()*2.7});",
    "wakeTrail.push({x:state.x-headingX*back+sideX*side,y:state.y-headingY*back+sideY*side,life:20,maxLife:20,size:2.5+Math.random()*3.2});",
    'wake lifetime')
old_draw_wake = """  function drawWakeTrail(){\n    if(!wakeTrail.length)return;ctx.save();\n    for(const mark of wakeTrail){const p=worldToScreen(mark.x,mark.y);if(p.x<-30||p.x>width+30||p.y<60||p.y>height+30)continue;const age=1-mark.life/mark.maxLife,alpha=Math.max(0,Math.min(.42,mark.life/mark.maxLife*.42)),stretch=1.2+age*2.4;ctx.fillStyle=`rgba(236,251,255,${alpha})`;ctx.beginPath();ctx.ellipse(p.x,p.y,mark.size*stretch,mark.size*(.48+age*.28),0,0,Math.PI*2);ctx.fill();}\n    ctx.restore();\n  }\n"""
new_draw_wake = """  function drawWakeTrail(){\n    if(!wakeTrail.length)return;ctx.save();\n    for(const mark of wakeTrail){const p=worldToScreen(mark.x,mark.y);if(p.x<-35||p.x>width+35||p.y<60||p.y>height+35)continue;const age=1-mark.life/mark.maxLife,fade=Math.max(0,mark.life/mark.maxLife),alpha=.18+.5*fade,stretch=1.15+age*2.1;ctx.fillStyle=`rgba(239,253,255,${alpha})`;ctx.beginPath();ctx.ellipse(p.x,p.y,mark.size*stretch,mark.size*(.58+age*.24),0,0,Math.PI*2);ctx.fill();ctx.strokeStyle=`rgba(126,205,223,${.12+.22*fade})`;ctx.lineWidth=.8;ctx.stroke();}\n    ctx.restore();\n  }\n"""
g = replace_once(g, old_draw_wake, new_draw_wake, 'wake draw')

# Voyage track since the most recent port call.
track_funcs = '''  function appendVesselTrack(force=false){
    const track=Array.isArray(state.track)?state.track:(state.track=[]),lastPoint=track[track.length-1];
    if(force||!lastPoint||Math.hypot(state.x-lastPoint.x,state.y-lastPoint.y)>=5){track.push({x:state.x,y:state.y});if(track.length>900)track.splice(0,track.length-900);}
  }
  function drawVesselTrack(){
    const track=state.track;if(!Array.isArray(track)||!track.length)return;
    ctx.save();ctx.lineCap='round';ctx.lineJoin='round';ctx.setLineDash([5,6]);ctx.strokeStyle='rgba(255,225,94,.7)';ctx.lineWidth=1.4;ctx.beginPath();
    let started=false;for(const point of track){const p=worldToScreen(point.x,point.y);if(!started){ctx.moveTo(p.x,p.y);started=true;}else ctx.lineTo(p.x,p.y);}const live=worldToScreen(state.x,state.y);if(started)ctx.lineTo(live.x,live.y);ctx.stroke();ctx.setLineDash([]);ctx.restore();
  }
'''
g = replace_once(g, '  function updateWakeTrail(dt){', track_funcs + '  function updateWakeTrail(dt){', 'track funcs')

g = replace_once(g,
    "drawIceThicknessAndCracks();drawMarginalFloes();drawWakeTrail();drawWakeFloes();",
    "drawIceThicknessAndCracks();drawMarginalFloes();drawVesselTrack();drawWakeTrail();drawWakeFloes();",
    'draw track')

